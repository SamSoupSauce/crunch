{
  "name": "crunch-game",
  "version": "1.7.0",
  "description": "A game of long-form strategy, 3-axis spatial control, and psychological deception.",
  "main": "main.js",
  "author": "Samuel L Meyers <sam@samuel-meyers.com>",
  "license": "MIT",
  "homepage": "https://samsoupsauce.github.io/crunch/",
  "repository": {
    "type": "git",
    "url": "https://github.com/SamSoupSauce/crunch.git"
  },
  "scripts": {
    "start": "electron .",
    "test": "node test_session.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --x64 --arm64",
    "dist:mac": "electron-builder --mac --x64 --arm64",
    "dist:win": "electron-builder --win --x64 --arm64",
    "dist:linux": "electron-builder --linux --x64 --arm64",
    "dist:all": "electron-builder -mwl --x64 --arm64",
    "prepare:www": "node scripts/prepare-www.js",
    "android:sync": "npm run prepare:www && cap sync android",
    "android:open": "cap open android",
    "android:build": "npm run android:sync && cd android && export JAVA_HOME=\"${JAVA_HOME:-/opt/homebrew/opt/openjdk@21}\" && ./gradlew assembleDebug"
  },
  "build": {
    "appId": "com.samsoupsauce.crunch",
    "productName": "Crunch",
    "copyright": "Copyright © 2026 Samuel L Meyers",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "index.html",
      "main.js",
      "preload.js",
      "session.js",
      "icon.svg",
      "favicon.ico",
      "RULES.md",
      "build/**/*"
    ],
    "mac": {
      "category": "public.app-category.board-games",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "Game"
    }
  },
  "devDependencies": {
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2"
  }
}
